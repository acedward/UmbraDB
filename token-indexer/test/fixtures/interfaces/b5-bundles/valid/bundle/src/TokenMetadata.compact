// SPDX-License-Identifier: Apache-2.0
//
// The reference module of MIP-0018, "On-Chain Token Metadata Emission"
// (MIP PR #325, `mips/mip-0018-on-chain-token-metadata.md` @ `37a3471`, status
// Proposed), on the UC-1 layout: an AMENDMENT IN DEVELOPMENT of the event
// `mip-0018:token-metadata[v1]` (the MIP text is unchanged; the amendment is
// recorded in ../TOKEN-METADATA.md). The MIP is the normative text for every
// rule not listed here.
//
// UC-1. Events named `mip-0018:token-metadata[v1]` follow the Multi-Part Event
// rule (`mip-xxxx:multi-part[v1]`): a reader merges every such event of one
// contract in one intent of one transaction, in emission order, into ONE
// package of 256·k bytes (k >= 1; a single event is k = 1). The payload below
// is that package:
//
//   offset  0  32  domainSep   the token within this contract (ERC-1155 `id`)
//   offset 32   1  kind        0 unshielded native, 1 shielded native,
//                              2 unshielded ledger, 3 shielded ledger
//   offset 33  32  key         key identifier bytes, NUL-padded; a key starting
//                              with `/metadata/` must be an RFC 6901 pointer
//   offset 65   1  val-type    0 opaque, 1 UTF-8 string, 2 unsigned integer
//                              (Compact `Uint<8*val-len>`, 1 <= val-len <= 31),
//                              3 UTF-8 JSON (ONE complete value), 4 UTF-8
//                              absolute URI, 5 Null (val-len 0);
//                              6..255 reserved (a consumer rejects the package)
//   offset 66   2  val-len     unsigned 16-bit, LITTLE-ENDIAN (Compact's own
//                              `Uint<16>` serialization): 0..65535, with
//                              68 + val-len <= 256·k
//   offset 68   …  value       `val-len` bytes; every byte after them is ignored
//
//   32 + 1 + 32 + 1 + 2 = 68 header bytes, so one event holds 188 value bytes.
//
// ONE PACKAGE = ONE DECLARATION. Multi-part only lengthens one value; it never
// carries several declarations. So a contract MUST NOT emit two declarations
// in one intent — in this module's terms: one emitting circuit call emits one
// declaration (a one-part `emitTokenMetadata`, or `emitHead` followed by its
// `emitPart`s), and the deployer sends one call per transaction.
//
// A LONG VALUE (more than 188 bytes) is one circuit call that emits every part,
// in order: `emitHead(…, valLen, first 188 bytes)`, then `emitPart(next 256)` as
// many times as needed — all in one intent, guaranteed ([Y] §5). With literal
// arguments the whole package costs a few rows (see ./generated/).
//
// WHO MAY EMIT. The emitter secret (spec 00024 Q12): the contract's constructor
// stores `emitterSecretHashOf(secret)` in a sealed ledger field
// (`initializeEmitter`), and every emitting circuit calls `assertEmitter()`
// first, which proves knowledge of the secret through the `emitterSecret`
// witness. The secret is a private proof input — prove on a proof server you
// run. The contract's maintenance authority outranks it, as always.
//
// A constructor cannot emit, so contracts expose emitting circuits that the
// deployer calls right after deployment (MIP section 6.7).
//
// LEGACY NAME. The Stagenet reference set recorded in ../deployments/ was
// deployed from commit `1721636` under the pre-final placeholder name
// `mip-xxxx:token-metadata[v1]` and the one-byte `val-len` layout. Those events
// are NOT `mip-0018:token-metadata[v1]` events and a conforming consumer
// ignores them (MIP sections 1 and 8); see ../TOKEN-METADATA.md "The legacy name".

pragma language_version >= 0.26.0;

module TokenMetadata {
  import CompactStandardLibrary;

  /**
   * @description The event name of MIP section 1, `pad(32, "mip-0018:token-metadata[v1]")`:
   * the 27 bytes `6d69702d303031383a746f6b656e2d6d657461646174615b76315d` followed by five
   * NULs. A consumer accepts a `Misc` event as a TokenMetadata event if and only if its
   * name is exactly these 32 bytes.
   *
   * @dev This literal is the ONLY place the name is written in this module. The UC-1
   * amendment keeps the name (`[v1]` is amended in place while everything is in
   * development — spec 00024 "Everything is in development").
   */
  export circuit EVENT_NAME(): Bytes<32> {
    return pad(32, "mip-0018:token-metadata[v1]");
  }

  /** The `kind` byte of a native unshielded token (MIP section 3). */
  export circuit KIND_UNSHIELDED(): Uint<8> { return 0; }

  /** The `kind` byte of a native shielded token (MIP section 3). */
  export circuit KIND_SHIELDED(): Uint<8> { return 1; }

  /** Added to a privacy bit: balances live in contract state, not in UTxOs. */
  export circuit KIND_LEDGER_FLAG(): Uint<8> { return 2; }

  // The `val-type` byte of MIP section 2.1. Values 6..255 are reserved and a
  // consumer MUST reject a package carrying one, so there is no constant for
  // them: nothing in this repository may emit one on purpose.

  /** `val-type` 0 — opaque bytes, no parsing rule at all. */
  export circuit VAL_TYPE_OPAQUE(): Uint<8> { return 0; }

  /** `val-type` 1 — `value[0..val-len]` is valid UTF-8. */
  export circuit VAL_TYPE_STRING(): Uint<8> { return 1; }

  /**
   * `val-type` 2 — an unsigned integer, serialized as the Compact type
   * `Uint<8 * val-len>` with `1 <= val-len <= 31`. MIP Appendix A's recommended
   * default is `Uint<128>`, i.e. `val-len = 16`.
   */
  export circuit VAL_TYPE_INTEGER(): Uint<8> { return 2; }

  /** `val-type` 3 — ONE complete UTF-8 JSON value (RFC 8259); a fragment is rejected. */
  export circuit VAL_TYPE_JSON(): Uint<8> { return 3; }

  /** `val-type` 4 — valid UTF-8 that parses as an absolute URI. */
  export circuit VAL_TYPE_URI(): Uint<8> { return 4; }

  /**
   * `val-type` 5 — Null: the key's current value is cleared. `val-len` MUST be
   * zero and every value byte is ignored (MIP sections 2.1 and 6.2). It is
   * distinct from an empty string, from empty opaque bytes and from the JSON
   * literal `null` carried under `val-type` 3, and it does not erase history.
   */
  export circuit VAL_TYPE_NULL(): Uint<8> { return 5; }

  /** UC-1: the value bytes one event (a one-part package) holds, 256 − 68. */
  export circuit ONE_PART_VALUE_SIZE(): Uint<16> { return 188; }

  // ---------------------------------------------------------------------------
  // The emitter secret (spec 00024 Q12)
  // ---------------------------------------------------------------------------

  /**
   * The commitment to the emitter's secret. Sealed: written only by the
   * constructor (through `initializeEmitter`), so every part of a package reads
   * the same unchanging value.
   */
  export sealed ledger emitterSecretHash: Bytes<32>;

  /**
   * The emitter's secret, from its local private state. A private proof input:
   * the proof server sees it, so prove on one you run, and never log it.
   */
  witness emitterSecret(): Bytes<32>;

  /** The domain tag of the commitment, before NUL padding to 32 bytes. */
  export pure circuit EMITTER_DOMAIN(): Bytes<32> {
    return pad(32, "mip-0018:emitter:");
  }

  /**
   * @description The public commitment a constructor stores for `secret`:
   * `persistentHash<Vector<2, Bytes<32>>>([pad(32, "mip-0018:emitter:"), secret])`,
   * which is SHA-256 over the 64 concatenated bytes. Compute it off chain and pass
   * it to the constructor; the secret itself never reaches the chain.
   */
  export pure circuit emitterSecretHashOf(secret: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "mip-0018:emitter:"), secret]);
  }

  /** Call once, from the importing contract's constructor. */
  export circuit initializeEmitter(hash: Bytes<32>): [] {
    assert(hash != default<Bytes<32>>, "TokenMetadata: zero emitter secret hash");
    emitterSecretHash = disclose(hash);
  }

  /**
   * @description Every emitting circuit calls this FIRST. A caller without the
   * secret fails here while executing, before any proof or event exists.
   */
  export circuit assertEmitter(): [] {
    assert(emitterSecretHashOf(emitterSecret()) == emitterSecretHash,
           "TokenMetadata: caller is not the emitter");
  }

  // ---------------------------------------------------------------------------
  // Emitting
  // ---------------------------------------------------------------------------

  /**
   * @description Emits the FIRST event of a package: the 68-byte header and the
   * first 188 value bytes. `valLen` is the length of the WHOLE value, so a value
   * longer than 188 bytes continues in the `emitPart` events the same circuit
   * call emits right after this one (UC-1; the Multi-Part Event rule merges them).
   *
   * This circuit checks nothing about `valLen` on purpose: it is the raw
   * transport the one-part and the multi-part paths share, and the probe uses it
   * to build payloads a consumer must reject. Contracts call `emitTokenMetadata`
   * for a one-part value.
   *
   * Everything reaching `emit` is public: callers pass `disclose(...)` for any
   * witness-derived value (MIP section 6.6).
   *
   * @param {Bytes<32>} domainSep - The token's domain separator.
   * @param {Uint<8>} kind - The kind byte 0..3 (MIP section 3).
   * @param {Bytes<32>} key - The key name, NUL-padded to 32 bytes.
   * @param {Uint<8>} valType - How to read the value (MIP section 2.1).
   * @param {Uint<16>} valLen - The length of the whole value, little-endian on the wire.
   * @param {Bytes<188>} valueHead - The value's first 188 bytes, NUL-padded.
   */
  export circuit emitHead(
    domainSep: Bytes<32>,
    kind: Uint<8>,
    key: Bytes<32>,
    valType: Uint<8>,
    valLen: Uint<16>,
    valueHead: Bytes<188>
  ): [] {
    emit(Misc {
      name: EVENT_NAME(),
      // 32 + 1 + 32 + 1 + 2 + 188 = 256. `valLen as Bytes<2>` is the Compact
      // Uint-to-Bytes cast: the first byte is the least significant (little-endian).
      payload: Bytes[...domainSep, kind, ...key, valType, ...(valLen as Bytes<2>), ...valueHead]
    });
  }

  /**
   * @description Emits one CONTINUATION part of a package: the next 256 bytes of
   * the value, NUL-padded after its end. Call it only right after `emitHead` (or
   * another `emitPart`) in the SAME circuit call, so every part of the package is
   * in one intent and one execution phase — guaranteed, as the Multi-Part Event
   * rule recommends ([Y] §5). The reader concatenates the parts in emission order
   * and keeps all 256 bytes of each; no byte of a part is framing ([Y] §4).
   *
   * A value of `valLen` bytes takes `ceil((68 + valLen) / 256)` parts: the head
   * holds the first 188 bytes and each part the next 256. The bytes after the
   * value in the last part are ignored by a consumer; emitters SHOULD zero them.
   *
   * @param {Bytes<256>} part - The next 256 bytes of the value.
   */
  export circuit emitPart(part: Bytes<256>): [] {
    emit(Misc { name: EVENT_NAME(), payload: part });
  }

  /**
   * @description Emits one ONE-PART declaration of `key` = `value` for the token
   * `(this contract, domainSep, kind)`: a package of exactly one event.
   *
   * @param {Bytes<32>} domainSep - The token's domain separator.
   * @param {Uint<8>} kind - The kind byte 0..3 (MIP section 3).
   * @param {Bytes<32>} key - The key name, NUL-padded to 32 bytes.
   * @param {Uint<8>} valType - How to read `value` (MIP section 2.1).
   * @param {Uint<16>} valLen - The number of meaningful bytes in `value`, 0..188.
   * @param {Bytes<188>} value - The value bytes, NUL-padded after `valLen`.
   */
  export circuit emitTokenMetadata(
    domainSep: Bytes<32>,
    kind: Uint<8>,
    key: Bytes<32>,
    valType: Uint<8>,
    valLen: Uint<16>,
    value: Bytes<188>
  ): [] {
    assert(valLen <= ONE_PART_VALUE_SIZE(),
           "TokenMetadata: a one-part value holds at most 188 bytes");
    emitHead(domainSep, kind, key, valType, valLen, value);
  }

  /**
   * @description Clears the current value of `key` for the token
   * `(this contract, domainSep, kind)` by emitting a Null declaration —
   * `val-type` 5, `val-len` 0, all 188 value bytes NUL (MIP sections 2.1 and
   * 6.2). The key's earlier values remain history; only the current value goes.
   *
   * @param {Bytes<32>} domainSep - The token's domain separator.
   * @param {Uint<8>} kind - The kind byte 0..3.
   * @param {Bytes<32>} key - The key to clear, NUL-padded to 32 bytes.
   */
  export circuit emitNull(domainSep: Bytes<32>, kind: Uint<8>, key: Bytes<32>): [] {
    emitHead(domainSep, kind, key, VAL_TYPE_NULL(), 0, pad(188, ""));
  }
}
