{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/midnight-experiments/mip-0018/vectors/schema/payload.schema.json",
  "title": "MIP-0018 payload vector",
  "description": "One observed event and the decode/classify result a conforming consumer must reach. Only `result`, `header`, `records` (and `contentEnd`) are normative; `reason` and `offset` are repository-defined and informative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mip", "normative", "description", "event", "expect"],
  "properties": {
    "id": { "$ref": "#/$defs/vectorId" },
    "mip": { "$ref": "#/$defs/mipRef" },
    "normative": { "type": "boolean" },
    "description": { "type": "string", "minLength": 1 },
    "basis": {
      "description": "Informative vectors only: where the expected result comes from (MIP text or owner ruling).",
      "type": "string",
      "minLength": 1
    },
    "event": { "$ref": "#/$defs/event" },
    "expect": { "$ref": "#/$defs/decodeExpectation" }
  },
  "if": { "properties": { "normative": { "const": true } } },
  "then": {
    "description": "Normative vectors carry the full 32-byte name and 256-byte payload, as the MIP's Testing items do.",
    "properties": {
      "event": {
        "type": "object",
        "properties": { "name_hex": { "$ref": "#/$defs/hex32" }, "payload_hex": { "$ref": "#/$defs/hex256" } }
      }
    }
  },
  "$defs": {
    "vectorId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hex256": { "type": "string", "pattern": "^[0-9a-f]{512}$" },
    "observedNameHex": {
      "description": "An event name as a source returned it: 32 bytes, or fewer when the source dropped trailing zero bytes (consumers zero-extend it, MIP \"Consuming\"). Informative vectors may give a longer value, which is another name.",
      "type": "string",
      "pattern": "^([0-9a-f]{2}){0,64}$"
    },
    "observedPayloadHex": {
      "description": "An event payload as a source returned it: 256 bytes, or fewer when the source dropped trailing zero bytes (consumers zero-extend it, MIP \"Consuming\"). Informative vectors may give a longer value, which consumers reject.",
      "type": "string",
      "pattern": "^([0-9a-f]{2}){0,512}$"
    },
    "uintDecimal": {
      "description": "An unsigned integer as a decimal string (no sign, no leading zeros), so that every width up to 31 bytes is exact in every language.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "mipRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "testId"],
      "properties": {
        "commit": { "const": "78ecbb4b1ba57371e84fe45f705991ab7b996a61" },
        "testId": {
          "description": "The MIP Testing item (A1…A5, R1…R6, IGNORE, S1…S9) or `INF-…` for an informative vector.",
          "type": "string",
          "pattern": "^(A[1-5]|R[1-6]|IGNORE|S[1-9]|INF-[A-Z0-9-]+)$"
        }
      }
    },
    "eventType": {
      "description": "MIP-0002 `LogEventType` variant name.",
      "enum": [
        "ShieldedSpend",
        "ShieldedReceive",
        "ShieldedMint",
        "ShieldedBurn",
        "UnshieldedSpend",
        "UnshieldedReceive",
        "UnshieldedMint",
        "UnshieldedBurn",
        "Paused",
        "Unpaused",
        "Misc"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name_hex", "payload_hex"],
      "properties": {
        "type": { "$ref": "#/$defs/eventType" },
        "name_hex": { "$ref": "#/$defs/observedNameHex" },
        "payload_hex": { "$ref": "#/$defs/observedPayloadHex" },
        "payload_file": {
          "description": "The same payload bytes as a binary file next to this JSON file.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.bin$"
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domainSep", "kind"],
      "properties": {
        "domainSep": { "$ref": "#/$defs/hex32" },
        "kind": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "key_hex", "valType", "value_hex"],
      "properties": {
        "offset": { "description": "Offset of the record's keyLen byte in the payload.", "type": "integer", "minimum": 33, "maximum": 252 },
        "key_hex": { "type": "string", "pattern": "^([0-9a-f]{2}){1,255}$" },
        "key_text": { "description": "Informative: the key as text when it is printable UTF-8.", "type": "string" },
        "valType": { "type": "integer", "minimum": 0, "maximum": 5 },
        "value_hex": { "type": "string", "pattern": "^([0-9a-f]{2}){0,255}$" },
        "value_text": { "description": "Informative: the value as text for value types 1, 3 and 4 when printable.", "type": "string" },
        "decoded": {
          "description": "valType 2 only: the little-endian unsigned integer as a decimal string.",
          "$ref": "#/$defs/uintDecimal"
        }
      }
    },
    "decodeExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": { "enum": ["accept", "reject", "ignore"] },
        "reason": { "description": "Informative, repository-defined reason code.", "type": "string", "pattern": "^[a-z0-9-]+$" },
        "offset": { "description": "Informative: payload offset where the check failed.", "type": "integer", "minimum": 0, "maximum": 256 },
        "header": { "$ref": "#/$defs/header" },
        "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
        "contentEnd": { "description": "Offset right after the last record.", "type": "integer", "minimum": 37, "maximum": 256 }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "accept" } } },
          "then": { "required": ["header", "records", "contentEnd"], "not": { "required": ["reason"] } }
        },
        {
          "if": { "properties": { "result": { "const": "reject" } } },
          "then": { "required": ["reason"], "not": { "anyOf": [{ "required": ["header"] }, { "required": ["records"] }, { "required": ["contentEnd"] }] } }
        },
        {
          "if": { "properties": { "result": { "const": "ignore" } } },
          "then": { "not": { "anyOf": [{ "required": ["header"] }, { "required": ["records"] }, { "required": ["contentEnd"] }, { "required": ["offset"] }] } }
        }
      ]
    }
  }
}
